<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss.SSS}] [%-5level] [%X{traceId:-startup}] [%X{userId:-anonymous}] %logger{36}.%M:%L - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO"> <appender-ref ref="CONSOLE" />
    </root>
</configuration>